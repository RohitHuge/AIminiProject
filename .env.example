# ---- Backend / server (NEVER exposed to the browser) ----
OPENAI_API_KEY=
# Model used by the generation agent (override if needed)
OPENAI_MODEL=gpt-4.1
PORT=3001

# ---- LiveKit (Phase 6 — voice). Secret stays server-side only ----
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- Voice worker (voice/) ----
# Where the worker POSTs the Learning Brief + triggers generation
BACKEND_URL=http://127.0.0.1:3001
# OpenAI Realtime model used by the voice agent
OPENAI_REALTIME_MODEL=gpt-realtime

# ---- Optional: override where session folders are stored ----
# Defaults to <repo-root>/sessions
# SESSIONS_DIR=
